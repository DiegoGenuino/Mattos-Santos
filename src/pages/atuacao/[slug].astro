---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ProcessSection from '@/components/ProcessSection.astro';
import WhatsAppIcon from '@/components/WhatsAppIcon.astro';
import { siteConfig } from '@/config/site';
import type { ServicePageConfig } from '@/config/site';

export function getStaticPaths() {
  return siteConfig.servicePages.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServicePageConfig;
}

const { service } = Astro.props;
const { about, contact, identity } = siteConfig;
const aboutSrcset = about.image.srcset.map(({ src, width }) => `${src} ${width}w`).join(', ');
---

<BaseLayout title={service.eyebrow} description={service.seoDescription}>
  <Header />
  <main class="service-page">
    <section class="service-hero" aria-labelledby="service-title">
      <div class="container service-hero-grid">
        <div class="service-hero-copy">
          <a class="service-back" href="/#especialidades"><Icon name="lucide:arrow-left" aria-hidden="true" /> Todas as áreas</a>
          <span class="service-icon" aria-hidden="true"><Icon name={service.icon} /></span>
          <p class="section-kicker">{service.eyebrow}</p>
          <h1 id="service-title">{service.title}</h1>
          <p>{service.summary}</p>
          <a
            class="button button-primary button-large"
            href={contact.whatsappUrl}
            target="_blank"
            rel="noreferrer"
            data-whatsapp-launcher
            data-whatsapp-topic={service.eyebrow}
          >
            <WhatsAppIcon />
            {service.ctaLabel}
          </a>
        </div>

        <figure class="service-portrait">
          <picture>
            <source type="image/webp" srcset={aboutSrcset} sizes="(max-width: 780px) calc(100vw - 34px), 420px" />
            <img
              src={about.image.src}
              width={about.image.width}
              height={about.image.height}
              alt={about.image.alt}
              loading="eager"
              decoding="async"
            />
          </picture>
          <figcaption>
            <strong>{identity.professionalName || 'Especialista responsável'}</strong>
            <span>{identity.professionalRole}</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="section service-detail">
      <div class="container service-detail-grid">
        <div class="service-introduction">
          <p>{service.introduction}</p>
          <aside>
            <Icon name="lucide:shield-check" aria-hidden="true" />
            <span>Conteúdo informativo. Cada situação depende de análise individual e não há promessa de resultado.</span>
          </aside>
        </div>

        <div class="service-situations">
          <h2>{service.situationsTitle}</h2>
          <ul>
            {service.situations.map((situation) => (
              <li><Icon name="lucide:check" aria-hidden="true" /> <span>{situation}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="service-approach">
      <div class="container service-approach-grid">
        <p class="section-kicker">Atendimento responsável</p>
        <div>
          <h2>{service.approachTitle}</h2>
          <p>{service.approach}</p>
        </div>
      </div>
    </section>

    <ProcessSection />
  </main>
  <Footer />
</BaseLayout>
