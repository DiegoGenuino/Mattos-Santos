<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  const setMenuButtonLabel = (isOpen: boolean) => {
    const label = isOpen ? menuButton?.dataset.closeLabel : menuButton?.dataset.openLabel;
    if (label) menuButton?.setAttribute('aria-label', label);
  };

  const closeMenu = (restoreFocus = false) => {
    menuButton?.setAttribute('aria-expanded', 'false');
    mobileMenu?.classList.remove('is-open');
    mobileMenu?.setAttribute('inert', '');
    document.body.classList.remove('menu-open');
    setMenuButtonLabel(false);
    if (restoreFocus) menuButton?.focus();
  };

  menuButton?.addEventListener('click', () => {
    const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', String(!isOpen));
    mobileMenu?.classList.toggle('is-open', !isOpen);
    document.body.classList.toggle('menu-open', !isOpen);
    if (isOpen) mobileMenu?.setAttribute('inert', '');
    else {
      mobileMenu?.removeAttribute('inert');
      window.requestAnimationFrame(() => mobileMenu?.querySelector<HTMLAnchorElement>('a')?.focus());
    }
    setMenuButtonLabel(!isOpen);
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => closeMenu()));
  document.addEventListener('pointerdown', (event) => {
    if (
      menuButton?.getAttribute('aria-expanded') === 'true'
      && header
      && !header.contains(event.target as Node)
    ) closeMenu();
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth > 780) closeMenu();
  }, { passive: true });
  window.addEventListener('scroll', () => header?.classList.toggle('is-scrolled', window.scrollY > 24), { passive: true });

  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const observedSections = navLinks
    .map((link) => document.getElementById(link.dataset.navLink ?? ''))
    .filter((section): section is HTMLElement => Boolean(section));

  if (observedSections.length) {
    const navObserver = new IntersectionObserver((entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (!visible) return;

      navLinks.forEach((link) => {
        const isCurrent = link.dataset.navLink === visible.target.id;
        link.classList.toggle('is-current', isCurrent);
        if (isCurrent) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    }, { rootMargin: '-25% 0px -60% 0px', threshold: [0, 0.15, 0.4] });

    observedSections.forEach((section) => navObserver.observe(section));
  }

  const whatsappContact = document.querySelector<HTMLElement>('[data-whatsapp-contact]');
  const whatsappInvite = whatsappContact?.querySelector<HTMLElement>('[data-whatsapp-invite]');
  const whatsappClose = whatsappContact?.querySelector<HTMLButtonElement>('[data-whatsapp-close]');
  const whatsappButton = whatsappContact?.querySelector<HTMLButtonElement>('.floating-whatsapp');
  const whatsappChannels = [...(whatsappContact?.querySelectorAll<HTMLAnchorElement>('[data-whatsapp-channel]') ?? [])];
  const whatsappTopics = [...(whatsappContact?.querySelectorAll<HTMLButtonElement>('[data-whatsapp-topic]') ?? [])];
  const whatsappLaunchers = document.querySelectorAll<HTMLElement>('[data-whatsapp-launcher]');
  let selectedTopic = '';
  let whatsappLastTrigger: HTMLElement | null = whatsappButton ?? null;

  const setWhatsappButtonLabel = (isOpen: boolean) => {
    const label = isOpen ? whatsappButton?.dataset.closeLabel : whatsappButton?.dataset.openLabel;
    if (label) whatsappButton?.setAttribute('aria-label', label);
  };

  const updateWhatsappLinks = (topic = '') => {
    selectedTopic = topic;
    whatsappTopics.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.whatsappTopic === topic)));
    whatsappChannels.forEach((channel) => {
      const baseUrl = channel.dataset.baseUrl ?? channel.href;
      const defaultMessage = channel.dataset.defaultMessage ?? 'Olá! Gostaria de conversar sobre o meu caso.';
      const message = topic ? `Olá! Gostaria de orientação sobre ${topic}.` : defaultMessage;
      channel.href = `${baseUrl}?text=${encodeURIComponent(message)}`;
    });
  };

  const showWhatsappInvite = (focusFirstControl = false, trigger?: HTMLElement) => {
    if (trigger) whatsappLastTrigger = trigger;
    const requestedTopic = trigger?.dataset.whatsappTopic;
    if (requestedTopic) updateWhatsappLinks(requestedTopic);
    whatsappInvite?.removeAttribute('inert');
    whatsappInvite?.setAttribute('aria-hidden', 'false');
    whatsappInvite?.classList.add('is-visible');
    whatsappButton?.setAttribute('aria-expanded', 'true');
    setWhatsappButtonLabel(true);

    if (focusFirstControl) {
      window.requestAnimationFrame(() => {
        const selectedButton = whatsappTopics.find((button) => button.dataset.whatsappTopic === selectedTopic);
        (selectedButton ?? whatsappTopics[0] ?? whatsappChannels[0])?.focus();
      });
    }
  };

  const hideWhatsappInvite = () => {
    whatsappInvite?.classList.remove('is-visible');
    whatsappInvite?.setAttribute('aria-hidden', 'true');
    whatsappInvite?.setAttribute('inert', '');
    whatsappButton?.setAttribute('aria-expanded', 'false');
    setWhatsappButtonLabel(false);
  };

  updateWhatsappLinks();

  whatsappButton?.addEventListener('click', () => {
    const isOpen = whatsappButton.getAttribute('aria-expanded') === 'true';
    if (isOpen) hideWhatsappInvite();
    else showWhatsappInvite(false, whatsappButton);
  });

  whatsappLaunchers.forEach((launcher) => launcher.addEventListener('click', (event) => {
    event.preventDefault();
    closeMenu();
    showWhatsappInvite(true, launcher);
  }));

  whatsappTopics.forEach((button) => button.addEventListener('click', () => {
    updateWhatsappLinks(button.dataset.whatsappTopic ?? '');
  }));

  whatsappChannels.forEach((channel) => channel.addEventListener('click', hideWhatsappInvite));
  whatsappClose?.addEventListener('click', () => {
    hideWhatsappInvite();
    whatsappLastTrigger?.focus();
  });

  document.addEventListener('pointerdown', (event) => {
    if (whatsappContact && !whatsappContact.contains(event.target as Node)) hideWhatsappInvite();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
      closeMenu(true);
      return;
    }
    if (event.key === 'Escape' && whatsappButton?.getAttribute('aria-expanded') === 'true') {
      hideWhatsappInvite();
      whatsappLastTrigger?.focus();
    }
  });

  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      entry.target.classList.add('is-visible');
      revealObserver.unobserve(entry.target);
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px' });

  document.querySelectorAll('[data-reveal]').forEach((element) => revealObserver.observe(element));
</script>
