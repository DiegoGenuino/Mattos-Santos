---
import ArrowUpRightIcon from '@/components/ArrowUpRightIcon.astro';
import { siteConfig } from '@/config/site';

const { contact, differentialsSection: section } = siteConfig;
---

<section class="section differentials" id={section.id}>
  <div class="container">
    <div class="section-heading differentials-heading" data-reveal>
      <h2>{section.titlePrefix} <span>{section.highlightedTitle}</span><br aria-hidden="true" /> {section.titleSuffix}</h2>
      <p>{section.description}</p>
    </div>

    <div class="differentials-slider">
      <div class="difference-stage" data-sticky-cards>
        {section.items.map((slide, index) => (
          <article
            class="featured-difference"
            id={`diferencial-card-${index + 1}`}
            aria-labelledby={`diferencial-title-${index + 1}`}
            style={`--stack-index: ${index}; --stack-offset: ${index * 14}px; --stack-layer: ${index + 1};`}
          >
            <div class="feature-identity">
              <span class="feature-story-label">{slide.storyLabel}</span>
              <h3 id={`diferencial-title-${index + 1}`}>{slide.title}</h3>
            </div>
            <div class="feature-detail">
              <p>{slide.description}</p>
              <a class="card-cta" href={contact.whatsappUrl} target="_blank" rel="noreferrer" data-whatsapp-launcher>
                <span>{section.ctaLabel}</span>
                <b aria-hidden="true"><ArrowUpRightIcon /></b>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
